# ----------------------------------------------------------------------------
# API Optimizer — frontend (React/Vite dashboard) environment variables
# Copy to `.env.local` and adjust. Never commit the real `.env.local`.
# These are inlined at build time by Vite (import.meta.env).
# ----------------------------------------------------------------------------

# Base URL of the deployed backend API (Vercel has no dev proxy).
# Leave unset to use relative "/api/v1" (works with the Vite dev proxy).
VITE_API_URL=

# Fully qualified URL to the backend's interactive docs (/docs).
# Leave unset to derive it from VITE_API_URL.
VITE_DOCS_URL=

# Dev only — where the Vite proxy forwards /api, /docs, /openapi.json.
VITE_PROXY_TARGET=http://127.0.0.1:8000
