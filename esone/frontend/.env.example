# Copy to .env for local development. Never commit .env.

ESONE_WEB_ENV=development

# Public origin of the Esone API (backend/). Local default below; on Render
# set it to the esone-api service URL, e.g. https://esone-api.onrender.com
# (no trailing slash). The page server injects it into every page.
ESONE_WEB_API_URL=http://localhost:8000
