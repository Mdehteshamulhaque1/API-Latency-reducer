# Copy to .env for local development. Never commit .env.

ESONE_ENV=development

# Local default is a SQLite file. For Supabase paste the *pooler* connection
# string from Project Settings > Database > Connection string (URI), e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Both ESONE_DATABASE_URL and plain DATABASE_URL are accepted.
ESONE_DATABASE_URL=sqlite+aiosqlite:///./esone.db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ESONE_SECRET_KEY=

ESONE_ACCESS_TOKEN_EXPIRE_MINUTES=15
ESONE_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated exact origins. Add your Vercel production URL in production.
ESONE_CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
# Optional regex for Vercel preview deployments, e.g.
# ESONE_CORS_ORIGIN_REGEX=^https://esone(-[a-z0-9-]+)?\.vercel\.app$
ESONE_CORS_ORIGIN_REGEX=

# Login/register attempts per IP per minute (0 disables).
ESONE_AUTH_RATE_LIMIT_PER_MINUTE=5
# Read the client IP from X-Forwarded-For (true behind Render's proxy).
ESONE_TRUST_PROXY=true

# Optional: seed a first administrator on startup (created once, if absent).
ESONE_ADMIN_USERNAME=
ESONE_ADMIN_EMAIL=
ESONE_ADMIN_PASSWORD=

# API Optimizer (LLM gateway) behind POST /api/v1/chat. Create one ordinary
# account on the Optimizer for Esone (viewer role is enough) and put it here.
# Leave empty to disable the playground (the endpoint answers 503).
ESONE_OPTIMIZER_URL=http://localhost:8001
ESONE_OPTIMIZER_USERNAME=
ESONE_OPTIMIZER_PASSWORD=
ESONE_OPTIMIZER_TIMEOUT_SECONDS=60

# Request telemetry: every request Esone serves and every call it makes is
# batched to the Optimizer (POST /api/v1/ingest/requests, same service
# account, which needs the operator or admin role there) so the Optimizer
# dashboard analyses Esone's traffic. Fails open; nothing is sent when the
# Optimizer settings above are empty.
ESONE_TELEMETRY_ENABLED=true
ESONE_TELEMETRY_SERVICE_NAME=esone
ESONE_TELEMETRY_FLUSH_SECONDS=30

# Project chatbot (POST /api/v1/chatbot, public): answers questions about the
# project from esone_api/chatbot/project_knowledge.txt. With a Gemini API key
# the model phrases the answer; without one the closest section is returned.
ESONE_GEMINI_API_KEY=
ESONE_GEMINI_MODEL=gemini-3.5-flash-lite
ESONE_CHATBOT_RATE_LIMIT_PER_MINUTE=10
