# ============================================================================
# API Optimizer — backend environment variables
# Copy to `.env` and adjust. Never commit the real `.env`.
# ============================================================================

# App
APP_NAME=API Optimizer
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Server (used by `python -m app.main`; uvicorn CLI overrides with --port)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ----------------------------------------------------------------------------
# Database
#   Local (SQLite):     sqlite+aiosqlite:///./api_optimizer.db
#   Production (MySQL): mysql+aiomysql://USER:PASSWORD@HOST:3306/api_optimizer
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./api_optimizer.db
DATABASE_ECHO=False
# Keep these modest — free-tier managed MySQL plans allow very few connections.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE=3600

# ----------------------------------------------------------------------------
# Redis (cache + rate-limit counters + Celery broker)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# JWT — generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters and unique per deployment.
# ----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# Celery (optional — the app boots without these; only set when running a worker)
# ----------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ----------------------------------------------------------------------------
# Rate limiting (fail-open: requests are allowed when Redis is unavailable)
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_PERIOD=3600

# ----------------------------------------------------------------------------
# CORS — JSON array of allowed browser origins (the deployed dashboards/site)
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ----------------------------------------------------------------------------
# Initial admin account (seeded by `python migrate_db.py`)
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
