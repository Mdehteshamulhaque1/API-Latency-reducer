# ============================================================================
# API Optimizer — backend environment variables
# Copy to `.env` and adjust. Never commit the real `.env`.
# ============================================================================

# App
APP_NAME=API Optimizer
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Server (used by `python -m app.main`; uvicorn CLI overrides with --port)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ----------------------------------------------------------------------------
# Database
#   Local (SQLite):        sqlite+aiosqlite:///./api_optimizer.db
#   Production (MySQL):    mysql+aiomysql://USER:PASSWORD@HOST:3306/api_optimizer
#   Production (Postgres): postgresql+asyncpg://USER:PASSWORD@HOST:5432/api_optimizer
# Schema is managed by Alembic: run `alembic upgrade head` after changing it.
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./api_optimizer.db
DATABASE_ECHO=False
# Keep these modest — free-tier managed databases allow very few connections.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE=3600

# ----------------------------------------------------------------------------
# Redis (response cache + token buckets + LLM exact-match cache + token denylist)
# Every Redis feature fails open: if Redis is down, requests still succeed
# without caching, rate limiting, or logout revocation.
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Applies to generic response caching and exact-match LLM chat caching.
REDIS_CACHE_TTL=3600
# Keep these short so cache/rate-limit failures fail open quickly.
REDIS_CONNECT_TIMEOUT=3
REDIS_SOCKET_TIMEOUT=3

# ----------------------------------------------------------------------------
# LLM provider. The gateway speaks the OpenAI Chat Completions protocol, so
# the OPENAI_* names are kept, but the default provider is Google Gemini via
# its OpenAI-compatible endpoint. Put your Gemini API key
# (https://aistudio.google.com/apikey) in OPENAI_API_KEY.
#   OPENAI_API_KEY is optional at startup. When unset, POST /api/v1/chat
#   returns a controlled 503 instead of calling the provider.
#
#   OpenAI instead:
#     OPENAI_BASE_URL=https://api.openai.com/v1
#     OPENAI_MODEL=gpt-4o-mini   OPENAI_FALLBACK_MODEL=gpt-4o   LLM_PROVIDER=openai
#   Free local alternative (no key needed): install Ollama, run
#   `ollama pull llama3.2`, then set
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     OPENAI_API_KEY=ollama            (any non-empty value)
#     OPENAI_MODEL=llama3.2
#     OPENAI_FALLBACK_MODEL=
#     LLM_PROVIDER=ollama
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.5-flash-lite
# Optional primary override. When empty, OPENAI_MODEL is used.
OPENAI_PRIMARY_MODEL=
# Fallback model used after primary timeouts, 429s, or 5xx responses. Leave
# empty to disable fallback.
OPENAI_FALLBACK_MODEL=gemini-3.5-flash
OPENAI_TIMEOUT_SECONDS=10
OPENAI_MAX_RETRIES=2
# Label written to ai_request_logs.provider, logs and metrics.
LLM_PROVIDER=gemini

# LLM circuit breaker (primary model only, in-process per worker)
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_CIRCUIT_HALF_OPEN_MAX_PROBES=1
LLM_CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=1

# ----------------------------------------------------------------------------
# AI guardrails. Injection detection is heuristic; "high" severity blocks the
# request when GUARDRAILS_BLOCK_INJECTION=True. PII masking replaces emails,
# phone and card numbers with placeholders before text reaches the provider.
# ----------------------------------------------------------------------------
GUARDRAILS_BLOCK_INJECTION=True
GUARDRAILS_MASK_PII=True

# ----------------------------------------------------------------------------
# Embeddings + RAG (knowledge base). The embedding endpoint is OpenAI-
# compatible and defaults to OPENAI_BASE_URL / OPENAI_API_KEY.
#   Gemini:  EMBEDDING_MODEL=gemini-embedding-001  (default)
#   OpenAI:  EMBEDDING_MODEL=text-embedding-3-small
#   Ollama:  EMBEDDING_MODEL=nomic-embed-text  EMBEDDING_BASE_URL=http://localhost:11434/v1
# Vectors are stored on local disk in CHROMA_PERSIST_DIR (ChromaDB).
# ----------------------------------------------------------------------------
EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
CHROMA_PERSIST_DIR=./data/chroma
MAX_UPLOAD_MB=10
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25
ASSISTANT_MAX_TOKENS=700

# Cost estimation (USD per 1,000,000 tokens). Per-model prices live in
# app/config.py PRICING_TABLE; these two are the fallback for unlisted models.
# Estimates are labelled as estimates in the API and dashboard.
CHAT_PROMPT_PRICE_PER_MILLION=0
CHAT_COMPLETION_PRICE_PER_MILLION=0

# ----------------------------------------------------------------------------
# JWT — generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters, unique per deployment, and NOT a placeholder.
# ----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# Only HS256 is supported; anything else will be rejected at startup.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# Demo / load-test endpoints (unauthenticated + unthrottled). Keep OFF in
# production; enable only for demos.
# ----------------------------------------------------------------------------
DEMO_ENDPOINT_ENABLED=False

# ----------------------------------------------------------------------------
# Trusted reverse proxies. Only these IPs may supply X-Forwarded-For for rate
# limiting; leave empty when the app is exposed directly.
# ----------------------------------------------------------------------------
# TRUSTED_PROXIES=["10.0.0.1","10.0.0.2"]

# ----------------------------------------------------------------------------
# Rate limiting: one token bucket per caller, sized by tier (the scheme most
# public APIs use). Capacity = requests, refilled evenly over the period, so a
# burst up to the capacity is allowed. Fails open when Redis is unavailable.
# Responses carry RateLimit-Limit/Remaining/Reset/Policy (IETF draft) and the
# older X-RateLimit-* headers; a 429 adds Retry-After.
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
# Anonymous callers, keyed by client IP. Browser traffic of a monitored
# service proxied through this gateway (PROXY_UPSTREAMS) falls in this tier.
RATE_LIMIT_ANONYMOUS_REQUESTS=60
RATE_LIMIT_ANONYMOUS_PERIOD=60
# Signed-in viewers and guests, keyed by user id.
RATE_LIMIT_USER_REQUESTS=300
RATE_LIMIT_USER_PERIOD=60
# Operators and admins: dashboards and service accounts that ship telemetry
# (Esone's account must be operator).
RATE_LIMIT_PRIVILEGED_REQUESTS=1000
RATE_LIMIT_PRIVILEGED_PERIOD=60

# ----------------------------------------------------------------------------
# Reverse proxy for monitored services. /proxy/<name>/<path> is forwarded to
# the mapped base URL; each call is logged under <name> (the dashboard shows
# it as that service's traffic), rate limited per client, and cached when a
# rule for /proxy/<name>/... exists. The upstream authenticates its own users.
# ----------------------------------------------------------------------------
PROXY_UPSTREAMS={"esone":"http://localhost:8000"}
PROXY_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------------------
# CORS — JSON array of allowed browser origins (the deployed dashboard)
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:4000","http://localhost:5173"]

# ----------------------------------------------------------------------------
# Initial admin account (seeded by `python migrate_db.py`). Only applied on
# first creation; existing admin passwords are never overwritten.
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# Question answering (POST /api/v1/answers), used by the Esone chat.
# A question is embedded and compared with stored questions in Redis; on a
# miss the crawler asks its sources, an answer is composed (by the LLM above
# when OPENAI_API_KEY is set, else from the best page's text) and stored.
# Every asked question is written to the answer_logs table and to a Redis
# list of the last hour for the dashboard.
# -----------------------------------------------------------------------------
ANSWERS_SIMILARITY_THRESHOLD=0.92
ANSWERS_LEXICAL_THRESHOLD=0.80
# Cached answers live for 2 hours (refreshed on every hit).
ANSWERS_CACHE_TTL=7200
ANSWERS_MAX_TOKENS=400
# Fast list of recently asked questions: window and maximum entries.
ANSWERS_RECENT_TTL=3600
# Time-sensitive questions (weather, prices, scores, "today") are cached only
# this long and are never matched semantically.
ANSWERS_VOLATILE_TTL=600
# Order after a cache miss: the model's own knowledge first (it must answer
# UNKNOWN when unsure), then Wikipedia, then the other sources. Set False to
# always research sources first and have the model cite them.
ANSWERS_MODEL_FIRST=True
# Stampede protection for identical concurrent questions: lock TTL and how
# long a waiting request polls for the first one's answer before generating.
ANSWERS_LOCK_TTL=45
ANSWERS_LOCK_WAIT_SECONDS=12
# Embedding price (USD per million tokens) for models not in the built-in
# EMBEDDING_PRICING_TABLE in app/config.py; 0 for local models. Costs are
# estimates, never provider billing.
EMBEDDING_PRICE_PER_MILLION=0
PRICING_CURRENCY=USD
# What a caller is charged (INR) per token of an answer that did not come from
# the cache or RAG: generated by the model or researched from other sources.
ANSWERS_INR_PER_TOKEN=5
PRICING_EFFECTIVE_DATE=2026-11-01
ANSWERS_RECENT_MAX=500
CRAWLER_MAX_RESULTS=3
CRAWLER_TIMEOUT_SECONDS=15
# Wikipedia asks for a descriptive User-Agent with a contact address.
CRAWLER_USER_AGENT=APIOptimizer/1.0 (answers crawler; contact: admin@example.com)
# Sources the crawler asks (comma separated): wikipedia, duckduckgo, wikidata,
# websearch. Sources that fail are skipped as long as one of them answers.
CRAWLER_SOURCES=wikipedia,duckduckgo,wikidata,websearch
# Keyed web search for the open web (government sites, trusted references).
#   brave:  https://brave.com/search/api  -> WEB_SEARCH_API_KEY
#   google: Programmable Search Engine    -> WEB_SEARCH_API_KEY + GOOGLE_CSE_ID
# Leave WEB_SEARCH_PROVIDER empty to disable; the free sources still work.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
GOOGLE_CSE_ID=
# Follow the top web results and extract the page text (else snippets only).
CRAWLER_FETCH_PAGES=True
CRAWLER_FETCH_LIMIT=3
CRAWLER_MAX_PAGE_BYTES=400000
# Domain suffixes ranked first among web results.
CRAWLER_TRUSTED_DOMAINS=.gov,.gov.in,.nic.in,.gov.uk,.gov.au,.gc.ca,.edu,.ac.uk,.ac.in,who.int,un.org,europa.eu,wikipedia.org,britannica.com,nih.gov,nasa.gov,bbc.co.uk,reuters.com,nature.com
